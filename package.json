{
  "name": "@shamanic-technologies/journalists-quotes-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && pnpm generate:openapi",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "rejudge-reset": "tsx scripts/rejudge-reset.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@sentry/node": "^10.76.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "postgres": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "qs@<6.16.0": "^6.16.1",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12",
      "@opentelemetry/api": "~1.9.1",
      "esbuild@>=0.27.0 <0.28.1": "^0.28.1",
      "body-parser@<1.20.9": "^1.20.9"
    }
  }
}
