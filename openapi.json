{
  "openapi": "3.0.0",
  "info": {
    "title": "Journalists Quotes Service",
    "description": "Automates expert-quote outreach via Featured.com Premium API. One run = sync questions, score against brand context, pick top 1, generate pitch, submit answer.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3050"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "ExpertQuoteRunResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "no_match",
              "rate_limited",
              "error"
            ]
          },
          "quoteRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "pitchId": {
            "type": "string",
            "format": "uuid"
          },
          "retryAfter": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "balance_cents": {
            "type": "integer"
          },
          "required_cents": {
            "type": "integer"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "ExpertQuoteRunRequest": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "brandId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "campaignId",
          "brandId"
        ]
      },
      "ProviderQuoteRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "ingestionChannel": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "featuredQuestionId": {
            "type": "integer",
            "nullable": true
          },
          "inboundEmailId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "mediaOutlet": {
            "type": "string",
            "nullable": true
          },
          "journalistName": {
            "type": "string",
            "nullable": true
          },
          "journalistEmail": {
            "type": "string",
            "nullable": true
          },
          "pitchEmail": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "opportunityText": {
            "type": "string"
          },
          "pitchUrl": {
            "type": "string",
            "nullable": true
          },
          "deadline": {
            "type": "string",
            "nullable": true
          },
          "fetchedAt": {
            "type": "string"
          },
          "quoteOpportunityId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "isCanonical": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string",
            "nullable": true
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "ingestionChannel",
          "externalId",
          "featuredQuestionId",
          "inboundEmailId",
          "mediaOutlet",
          "journalistName",
          "journalistEmail",
          "pitchEmail",
          "category",
          "opportunityText",
          "pitchUrl",
          "deadline",
          "fetchedAt",
          "quoteOpportunityId",
          "isCanonical",
          "fingerprint",
          "orgId",
          "createdAt",
          "updatedAt"
        ]
      },
      "QuoteRequestStats": {
        "type": "object",
        "properties": {
          "totalRequests": {
            "type": "integer"
          },
          "totalPitched": {
            "type": "integer"
          },
          "totalSelected": {
            "type": "integer"
          },
          "totalPublished": {
            "type": "integer"
          },
          "totalNotSelected": {
            "type": "integer"
          }
        },
        "required": [
          "totalRequests",
          "totalPitched",
          "totalSelected",
          "totalPublished",
          "totalNotSelected"
        ]
      },
      "QuotePitch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quoteRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "quoteOpportunityId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "featuredQuestionId": {
            "type": "integer",
            "nullable": true
          },
          "featuredProfileId": {
            "type": "integer",
            "nullable": true
          },
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "brandId": {
            "type": "string",
            "format": "uuid"
          },
          "draft": {
            "type": "string",
            "nullable": true
          },
          "pitchCharCount": {
            "type": "integer",
            "nullable": true
          },
          "pitchAttempts": {
            "type": "integer",
            "nullable": true
          },
          "contentGenRunId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "submittedAt": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "drafted",
              "submitted",
              "selected",
              "published",
              "not_selected",
              "error",
              "length_violation",
              "template_missing",
              "brand_missing_fields",
              "insufficient_credits"
            ]
          },
          "deliveryMethod": {
            "type": "string",
            "enum": [
              "featured_api",
              "email_reply"
            ]
          },
          "deliveryTarget": {
            "type": "string",
            "nullable": true
          },
          "outboundMessageId": {
            "type": "string",
            "nullable": true
          },
          "replyInThreadMessageId": {
            "type": "string",
            "nullable": true
          },
          "bounceStatus": {
            "type": "string",
            "nullable": true
          },
          "featuredArticleUrl": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "errorDetails": {
            "nullable": true
          },
          "parentRunId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "quoteRequestId",
          "quoteOpportunityId",
          "featuredQuestionId",
          "featuredProfileId",
          "campaignId",
          "brandId",
          "draft",
          "pitchCharCount",
          "pitchAttempts",
          "contentGenRunId",
          "submittedAt",
          "status",
          "deliveryMethod",
          "deliveryTarget",
          "outboundMessageId",
          "replyInThreadMessageId",
          "bounceStatus",
          "featuredArticleUrl",
          "error",
          "parentRunId",
          "runId",
          "orgId",
          "createdAt",
          "updatedAt"
        ]
      },
      "InboundEmailAcceptedResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "inboundEmailId": {
            "type": "string",
            "format": "uuid"
          },
          "deduplicated": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      },
      "PostmarkInboundWebhook": {
        "type": "object",
        "properties": {
          "MessageID": {
            "type": "string",
            "minLength": 1
          },
          "From": {
            "type": "string",
            "minLength": 1
          },
          "FromFull": {
            "type": "object",
            "properties": {
              "Email": {
                "type": "string",
                "minLength": 1
              },
              "Name": {
                "type": "string"
              },
              "MailboxHash": {
                "type": "string"
              }
            },
            "required": [
              "Email"
            ]
          },
          "To": {
            "type": "string",
            "minLength": 1
          },
          "ToFull": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Email": {
                  "type": "string",
                  "minLength": 1
                },
                "Name": {
                  "type": "string"
                },
                "MailboxHash": {
                  "type": "string"
                }
              },
              "required": [
                "Email"
              ]
            }
          },
          "Subject": {
            "type": "string"
          },
          "Date": {
            "type": "string"
          },
          "TextBody": {
            "type": "string"
          },
          "HtmlBody": {
            "type": "string"
          }
        },
        "required": [
          "MessageID",
          "From",
          "To"
        ]
      },
      "SyncTrackingResponse": {
        "type": "object",
        "properties": {
          "selectedUpdated": {
            "type": "integer"
          },
          "publishedUpdated": {
            "type": "integer"
          },
          "notSelectedUpdated": {
            "type": "integer"
          }
        },
        "required": [
          "selectedUpdated",
          "publishedUpdated",
          "notSelectedUpdated"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orgs/expert-quote-runs": {
      "post": {
        "summary": "Run one full expert-quote loop for the given campaign+brand",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpertQuoteRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpertQuoteRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credits in content-generation-service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpertQuoteRunResponse"
                }
              }
            }
          },
          "424": {
            "description": "Required precondition failed (brand fields missing or content-generation template missing)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpertQuoteRunResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-requests": {
      "get": {
        "summary": "List quote requests for the org",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "campaign_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "provider",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "ingestion_channel",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "List of quote requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providerQuoteRequests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProviderQuoteRequest"
                      }
                    }
                  },
                  "required": [
                    "providerQuoteRequests"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-requests/stats": {
      "get": {
        "summary": "Aggregate stats for quote requests + pitches",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "campaign_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteRequestStats"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-requests/{id}": {
      "get": {
        "summary": "Get a single quote request",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Quote request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteRequest": {
                      "$ref": "#/components/schemas/ProviderQuoteRequest"
                    }
                  },
                  "required": [
                    "quoteRequest"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-pitches": {
      "get": {
        "summary": "List quote pitches for the org",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "campaign_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "drafted",
                "submitted",
                "selected",
                "published",
                "not_selected",
                "error",
                "length_violation",
                "template_missing",
                "brand_missing_fields",
                "insufficient_credits"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "List of quote pitches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quotePitches": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/QuotePitch"
                      }
                    }
                  },
                  "required": [
                    "quotePitches"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-pitches/{id}": {
      "get": {
        "summary": "Get a single quote pitch",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Quote pitch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quotePitch": {
                      "$ref": "#/components/schemas/QuotePitch"
                    }
                  },
                  "required": [
                    "quotePitch"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/inbound-email": {
      "post": {
        "summary": "Receive inbound email forwarded by email-gateway-service (raw Postmark payload)",
        "description": "Service-to-service endpoint. Headers required: x-api-key (shared with caller), x-service-name=email-gateway-service. Idempotent on Postmark MessageID.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-service-name",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostmarkInboundWebhook"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email accepted (or deduplicated)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundEmailAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/sync-tracking": {
      "post": {
        "summary": "Poll Featured /selected /published /not-selected and reconcile",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sync results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncTrackingResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}