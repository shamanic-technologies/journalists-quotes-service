{
  "openapi": "3.0.0",
  "info": {
    "title": "Journalists Quotes Service",
    "description": "Three workflows: (WF1) email inbound HARO ingestion -> silver+gold; (WF2) /orgs/opportunities/next merges silver email opps with live Featured fetch + RAG scoring; (WF3) /orgs/opportunities/{id}/reply dispatches via Featured submitAnswer or email-gateway send.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3050"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "OpportunityNextResponse": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "match"
                ]
              },
              "opportunityId": {
                "type": "string",
                "format": "uuid"
              },
              "provider": {
                "type": "string"
              },
              "ingestionChannel": {
                "type": "string"
              },
              "featuredQuestionId": {
                "type": "integer",
                "nullable": true
              },
              "mediaOutlet": {
                "type": "string",
                "nullable": true
              },
              "journalistName": {
                "type": "string",
                "nullable": true
              },
              "opportunityText": {
                "type": "string"
              },
              "deadline": {
                "type": "string",
                "nullable": true
              },
              "pitchUrl": {
                "type": "string",
                "nullable": true
              },
              "pitchEmail": {
                "type": "string",
                "nullable": true
              },
              "score": {
                "type": "number"
              },
              "whyRelevant": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "status",
              "opportunityId",
              "provider",
              "ingestionChannel",
              "featuredQuestionId",
              "mediaOutlet",
              "journalistName",
              "opportunityText",
              "deadline",
              "pitchUrl",
              "pitchEmail",
              "score",
              "whyRelevant"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "no_match"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "OpportunityNextRequest": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "brandId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "campaignId",
          "brandId"
        ]
      },
      "OpportunityReplyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "already_submitted",
              "rate_limited",
              "error"
            ]
          },
          "pitchId": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryMethod": {
            "type": "string",
            "enum": [
              "featured_api",
              "email_reply"
            ]
          },
          "outboundMessageId": {
            "type": "string",
            "nullable": true
          },
          "featuredQuestionId": {
            "type": "integer",
            "nullable": true
          },
          "retryAfter": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "OpportunityReplyRequest": {
        "type": "object",
        "properties": {
          "pitchContent": {
            "type": "string",
            "minLength": 1
          },
          "brandId": {
            "type": "string",
            "format": "uuid"
          },
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "pitchContent",
          "brandId",
          "campaignId"
        ]
      },
      "ProcessInboundEmailsResponse": {
        "type": "object",
        "properties": {
          "processed": {
            "type": "integer"
          },
          "parsed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "silverRowsInserted": {
            "type": "integer"
          },
          "goldClustersCreated": {
            "type": "integer"
          }
        },
        "required": [
          "processed",
          "parsed",
          "failed",
          "skipped",
          "silverRowsInserted",
          "goldClustersCreated"
        ]
      },
      "ProviderQuoteRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "ingestionChannel": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "featuredQuestionId": {
            "type": "integer",
            "nullable": true
          },
          "inboundEmailId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "mediaOutlet": {
            "type": "string",
            "nullable": true
          },
          "journalistName": {
            "type": "string",
            "nullable": true
          },
          "journalistEmail": {
            "type": "string",
            "nullable": true
          },
          "pitchEmail": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "opportunityText": {
            "type": "string"
          },
          "pitchUrl": {
            "type": "string",
            "nullable": true
          },
          "deadline": {
            "type": "string",
            "nullable": true
          },
          "fetchedAt": {
            "type": "string"
          },
          "quoteOpportunityId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "isCanonical": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string",
            "nullable": true
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "ingestionChannel",
          "externalId",
          "featuredQuestionId",
          "inboundEmailId",
          "mediaOutlet",
          "journalistName",
          "journalistEmail",
          "pitchEmail",
          "category",
          "opportunityText",
          "pitchUrl",
          "deadline",
          "fetchedAt",
          "quoteOpportunityId",
          "isCanonical",
          "fingerprint",
          "orgId",
          "createdAt",
          "updatedAt"
        ]
      },
      "QuoteRequestStats": {
        "type": "object",
        "properties": {
          "totalRequests": {
            "type": "integer"
          },
          "totalPitched": {
            "type": "integer"
          }
        },
        "required": [
          "totalRequests",
          "totalPitched"
        ]
      },
      "QuotePitch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quoteRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "quoteOpportunityId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "featuredQuestionId": {
            "type": "integer",
            "nullable": true
          },
          "featuredProfileId": {
            "type": "integer",
            "nullable": true
          },
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "brandId": {
            "type": "string",
            "format": "uuid"
          },
          "draft": {
            "type": "string",
            "nullable": true
          },
          "pitchCharCount": {
            "type": "integer",
            "nullable": true
          },
          "pitchAttempts": {
            "type": "integer",
            "nullable": true
          },
          "contentGenRunId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "submittedAt": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "drafted",
              "submitted",
              "selected",
              "published",
              "not_selected",
              "error",
              "length_violation",
              "template_missing",
              "brand_missing_fields",
              "insufficient_credits"
            ]
          },
          "deliveryMethod": {
            "type": "string",
            "enum": [
              "featured_api",
              "email_reply"
            ]
          },
          "deliveryTarget": {
            "type": "string",
            "nullable": true
          },
          "outboundMessageId": {
            "type": "string",
            "nullable": true
          },
          "replyInThreadMessageId": {
            "type": "string",
            "nullable": true
          },
          "bounceStatus": {
            "type": "string",
            "nullable": true
          },
          "featuredArticleUrl": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "errorDetails": {
            "nullable": true
          },
          "parentRunId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "quoteRequestId",
          "quoteOpportunityId",
          "featuredQuestionId",
          "featuredProfileId",
          "campaignId",
          "brandId",
          "draft",
          "pitchCharCount",
          "pitchAttempts",
          "contentGenRunId",
          "submittedAt",
          "status",
          "deliveryMethod",
          "deliveryTarget",
          "outboundMessageId",
          "replyInThreadMessageId",
          "bounceStatus",
          "featuredArticleUrl",
          "error",
          "parentRunId",
          "runId",
          "orgId",
          "createdAt",
          "updatedAt"
        ]
      },
      "InboundEmailAcceptedResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "inboundEmailId": {
            "type": "string",
            "format": "uuid"
          },
          "deduplicated": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      },
      "PostmarkInboundWebhook": {
        "type": "object",
        "properties": {
          "MessageID": {
            "type": "string",
            "minLength": 1
          },
          "From": {
            "type": "string",
            "minLength": 1
          },
          "FromFull": {
            "type": "object",
            "properties": {
              "Email": {
                "type": "string",
                "minLength": 1
              },
              "Name": {
                "type": "string"
              },
              "MailboxHash": {
                "type": "string"
              }
            },
            "required": [
              "Email"
            ]
          },
          "To": {
            "type": "string",
            "minLength": 1
          },
          "ToFull": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Email": {
                  "type": "string",
                  "minLength": 1
                },
                "Name": {
                  "type": "string"
                },
                "MailboxHash": {
                  "type": "string"
                }
              },
              "required": [
                "Email"
              ]
            }
          },
          "Subject": {
            "type": "string"
          },
          "Date": {
            "type": "string"
          },
          "TextBody": {
            "type": "string"
          },
          "HtmlBody": {
            "type": "string"
          }
        },
        "required": [
          "MessageID",
          "From",
          "To"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orgs/opportunities/next": {
      "post": {
        "summary": "Pick the next best journalist opportunity for the (campaign, brand). Merges silver email-sourced rows with a live fetch of Featured.com opportunities, scores via RAG, returns top above SCORE_THRESHOLD.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpportunityNextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Top opportunity or no_match",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpportunityNextResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable (key-service, Featured)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/opportunities/{id}/reply": {
      "post": {
        "summary": "Submit a pitch reply for the given opportunity. Dispatches to Featured submitAnswer (provider=featured) or email-gateway-service /orgs/send (other providers, e.g. haro).",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpportunityReplyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pitch dispatched (or idempotent already-submitted)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpportunityReplyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or unsupported opportunity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Opportunity not found for this org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/process-inbound-emails": {
      "post": {
        "summary": "Drain pending inbound_emails rows, dispatch to parser by provider, insert silver rows + fingerprint cluster",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Processing result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessInboundEmailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-requests": {
      "get": {
        "summary": "List quote requests for the org",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "campaign_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "provider",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "ingestion_channel",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "List of quote requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providerQuoteRequests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProviderQuoteRequest"
                      }
                    }
                  },
                  "required": [
                    "providerQuoteRequests"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-requests/stats": {
      "get": {
        "summary": "Aggregate stats for quote requests + pitches",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "campaign_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteRequestStats"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-requests/{id}": {
      "get": {
        "summary": "Get a single quote request",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Quote request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteRequest": {
                      "$ref": "#/components/schemas/ProviderQuoteRequest"
                    }
                  },
                  "required": [
                    "quoteRequest"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-pitches": {
      "get": {
        "summary": "List quote pitches for the org",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "campaign_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "drafted",
                "submitted",
                "selected",
                "published",
                "not_selected",
                "error",
                "length_violation",
                "template_missing",
                "brand_missing_fields",
                "insufficient_credits"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "List of quote pitches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quotePitches": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/QuotePitch"
                      }
                    }
                  },
                  "required": [
                    "quotePitches"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orgs/quote-pitches/{id}": {
      "get": {
        "summary": "Get a single quote pitch",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Quote pitch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quotePitch": {
                      "$ref": "#/components/schemas/QuotePitch"
                    }
                  },
                  "required": [
                    "quotePitch"
                  ]
                }
              }
            }
          },
