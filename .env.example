JOURNALISTS_QUOTES_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/journalists_quotes_service
JOURNALISTS_QUOTES_SERVICE_API_KEY=your-secret-api-key
PORT=3050
SENTRY_DSN=

# Score threshold for picking top quote request (default 0.5)
SCORE_THRESHOLD=0.5

FEATURED_API_BASE_URL=https://featured.com/api/external-users

# Downstream services
RUNS_SERVICE_URL=http://localhost:3030
RUNS_SERVICE_API_KEY=your-runs-api-key
KEY_SERVICE_URL=http://localhost:3001
KEY_SERVICE_API_KEY=your-key-service-key
BRAND_SERVICE_URL=http://localhost:3005
BRAND_SERVICE_API_KEY=your-brand-service-key
CHAT_SERVICE_URL=http://localhost:3002
CHAT_SERVICE_API_KEY=your-chat-service-key

# Email gateway (outbound: WF3 email_reply dispatch)
EMAIL_GATEWAY_SERVICE_URL=http://localhost:3060
EMAIL_GATEWAY_SERVICE_API_KEY=your-email-gateway-key

# HMAC secret used by email-gateway to sign inbound webhook deliveries to
# /webhooks/inbound-email. Must match the value of `hmac_secret_env` referenced
# by the subscription registered in email-gateway-service.
JQS_INBOUND_HMAC_SECRET=replace-with-strong-secret

# Inbound email routing — JSON array mapping recipient alias to provider.
# Inbound emails arrive via email-gateway-service push (HMAC-signed) into
# /webhooks/inbound-email; aliases not listed here are stored with
# provider=null and /internal/process-inbound-emails marks them skipped.
INBOUND_ALIAS_ROUTING=[{"alias":"haro@inbox.example.com","provider":"haro"}]
